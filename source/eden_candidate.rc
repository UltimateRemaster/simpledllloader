// ============================================================
// IDENTIFY THE EDEN LOADER AND ITS ORIGINAL AUTHOR
// Keep the website and the user's fork in separate metadata fields.
// ============================================================
#include <winver.h>
LANGUAGE 0x09, 0x01
1 VERSIONINFO
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "aap / Ultimate Remaster\0"
            VALUE "FileDescription", "FFVIII Remastered DirectInput8 proxy and configured mod DLL loader; Eden fork by Ultimate Remaster.\0"
            VALUE "ProductName", "dinput8.dll\0"
            VALUE "LegalCopyright", "Copyright (c) 2017 aap. Eden fork modifications Copyright (c) Ultimate Remaster.\0"
            VALUE "Website", "https://ultimateremaster.com\0"
            VALUE "RepositoryUrl", "https://github.com/UltimateRemaster/simpledllloader\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
